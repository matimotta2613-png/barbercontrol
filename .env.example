# Conexión a PostgreSQL: postgresql://USUARIO:PASSWORD@SERVIDOR:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgresql://postgres:********@localhost:5433/barbercontrol?schema=public"

# Puerto del servidor Express
PORT=3000

# Zona horaria de la barbería (para validar que la cita sea futura)
ZONA_HORARIA="America/Chihuahua"
